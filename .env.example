GEMINI_API_KEY=
# Optional: the Gemini model (default gemini-flash-latest, always the newest Flash)
# GEMINI_MODEL=gemini-flash-latest
# Optional: models to try if the main one is retired or overloaded (comma-separated)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash
# Optional: local model for private mode (default gemma3:1b; gemma4:e2b is better but ~7 GB)
# LOCAL_MODEL=gemma4:e2b
