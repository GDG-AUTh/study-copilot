GEMINI_API_KEY=
# Optional: use Gemini through Vertex AI on this Google Cloud project instead of the key.
# Google's $300 trial credit cannot pay for AI Studio keys. Sign in with:
#   gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=my-project-id
# GOOGLE_CLOUD_LOCATION=global
# Optional: the Gemini model (default gemini-flash-latest, always the newest Flash)
# GEMINI_MODEL=gemini-flash-latest
# Optional: models to try if the main one is retired or overloaded (comma-separated)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash
# Optional: ask for this password in the browser (any username). Use it when the app is online.
# APP_PASSWORD=
# Optional: local model for private mode and when Gemini is unavailable (needs 8+ GB RAM)
# LOCAL_MODEL=gemma4:e2b-it-qat
